{
  "manifest_version": 3,
  "name": "Cognio Learning Companion",
  "version": "1.1.0",
  "description": "Solve questions, generate quizzes and receive user-approved adaptive learning support using local models.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "learning.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open Cognio" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
